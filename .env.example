# Default models go through the Vercel AI Gateway.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: enable agent/connections/example.ts
EXAMPLE_MCP_URL=

# Optional: record model and tool content in local traces (only if you delete
# agent/instrumentation.ts so eve's local tracer is active).
# EVE_TRACES_CONTENT=on
